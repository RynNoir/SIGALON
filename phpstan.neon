includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # Trait ini hanya dipakai oleh komponen Livewire single-file di resources/views/pages/settings/⚡profile.blade.php,
        # yang berada di luar `paths` sehingga PHPStan menganggapnya tidak terpakai.
        -
            identifier: trait.unused
            path: app/Concerns/ProfileValidationRules.php
