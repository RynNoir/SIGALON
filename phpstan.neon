includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # Trait ini hanya dipakai oleh komponen Livewire single-file di resources/views/pages/settings/
        # (⚡profile, ⚡security), yang berada di luar `paths` sehingga PHPStan menganggapnya tidak terpakai.
        -
            identifier: trait.unused
            paths:
                - app/Concerns/ProfileValidationRules.php
                - app/Concerns/PasswordValidationRules.php
